# Transit Late Again configuration. Copy to .env and fill in the two required values.
# Every variable here is documented in PROJECT.md §8; the values below are the
# defaults, so an .env containing only the two required lines is valid.
#
#   cp .env.example .env
#
# .env is in .gitignore and must never be committed.

# --- Required -----------------------------------------------------------------

# From the TfNSW Open Data Hub. Sent as "Authorization: apikey <KEY>", never as
# a query parameter. A wrong key is indistinguishable from a missing one until
# the first poll returns 401.
TFNSW_API_KEY=replace-me

# sslmode=disable is correct for the Compose-local Postgres only. Use
# sslmode=require for any remote database.
DATABASE_URL=postgres://headway:headway@localhost:5432/headway?sslmode=disable

# Docker Compose only (make up, and the VM): the password the postgres container
# is created with. Compose builds the service's DATABASE_URL from it, so the
# DATABASE_URL above stays pointed at the laptop's dev database. Hex, so it
# needs no escaping inside a URL: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Read by the integration tests only, never by the service. Unset means the
# integration suite skips rather than fails.
DATABASE_URL_TEST=postgres://headway:headway@localhost:5432/headway?sslmode=disable

# --- Feeds --------------------------------------------------------------------

FEEDS_FILE=config/feeds.json
# Comma-separated feed ids. Empty means every enabled feed in the catalogue.
# An id that is not in the catalogue is a startup error, not a warning.
ENABLED_FEEDS=
# The feeds refresh every 15s, so polling faster buys nothing. Must be >= 5s.
FEED_POLL_INTERVAL=15s
# Zero makes every poller fire in the same instant and trips the 5/s throttle.
FEED_POLL_JITTER=2s
FEED_HTTP_TIMEOUT=20s
# Above 5 trips the TfNSW throttle (403, X-Error-Detail: Account Over Rate Limit).
FEED_RATE_LIMIT_RPS=4
# Set this above the real account quota and you get 403s instead of a clean stop.
FEED_DAILY_BUDGET=55000
# Consecutive successful polls with a non-advancing header timestamp before the
# feed is marked stale. 8 polls is two minutes at the default interval.
FEED_STALE_POLLS=8
# Skew beyond this is logged and measured, never corrected.
FEED_MAX_SKEW=5m

# --- Schedule -----------------------------------------------------------------

SCHEDULE_REFRESH_INTERVAL=24h
# Local time. Must be outside the service peak: the load holds the parsed bundle
# in memory.
SCHEDULE_REFRESH_AT=03:30
# Older schedule versions are deleted once this many newer ones exist.
SCHEDULE_KEEP_VERSIONS=3

# --- Service-day maths --------------------------------------------------------

# How close to midnight an update must be for yesterday to be a candidate
# service date when the producer omits TripDescriptor.start_date.
SERVICE_DAY_OVERLAP_H=6
SERVICE_DATE_TOLERANCE=6h
# A stop time beyond this is rejected at load with the row number.
SERVICE_TIME_MAX_S=172800

# --- Ingest -------------------------------------------------------------------

# Must absorb the full-snapshot burst written by the first poll after a restart.
INGEST_QUEUE_SIZE=8192
INGEST_BATCH_SIZE=500
# The dominant term in freshness lag.
INGEST_FLUSH_INTERVAL=2s
# 0 writes on any change. Raising it cuts storage and quantises the history.
FILTER_MIN_DELTA_S=0
# Exceeding the bound evicts oldest-first, which costs redundant writes, never
# correctness.
FILTER_MAX_ENTRIES=500000
# When both delay and time are present and disagree by more than this against
# the schedule, delay wins.
DELAY_RECONCILE_TOLERANCE_S=60

# --- Classification -----------------------------------------------------------
# Transit Late Again's own definition, not TfNSW's (PROJECT.md §16 open question 2).
# Changing any of these invalidates comparisons with rollups already computed.

ON_TIME_EARLY_S=-60
ON_TIME_LATE_S=300
ON_TIME_VERY_LATE_S=900

# --- Retention and maintenance ------------------------------------------------

# Raw partitions only. Rollups are never dropped.
RETENTION_DAYS=14
# If this reaches zero, writes land in observations_default, which is an alert.
PARTITION_LOOKAHEAD_DAYS=3
MAINTENANCE_INTERVAL=15m

# --- HTTP ---------------------------------------------------------------------

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
# Must exceed the slowest history query or large responses truncate.
HTTP_WRITE_TIMEOUT=30s
# Must exceed INGEST_FLUSH_INTERVAL plus the time to write one batch.
HTTP_SHUTDOWN_GRACE=20s
# Per IP.
HTTP_RATE_LIMIT_RPS=50
# A header carrying the client's address, set by the only proxy that can reach
# this port. Empty uses the connection's address. Set it only when the port is
# not public, or any client can pick its own rate-limit bucket. The VM, whose
# firewall admits only Cloudflare to the port, uses CF-Connecting-IP.
HTTP_CLIENT_IP_HEADER=
# The one site allowed to read the API from a browser, as an origin: scheme
# and host, no trailing slash. Empty sends no CORS header. The VM uses
# https://transitlateagain.dev; for web/ against a local API, http://localhost:3000.
HTTP_CORS_ORIGIN=
# Serve HTTPS on HTTP_ADDR with this certificate and key; both or neither.
# Empty serves plain HTTP. The VM uses Cloudflare's origin certificate.
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=
# Caps the history query range; beyond it the API returns 400 range_too_large.
HISTORY_MAX_DAYS=90
# Shorter than the longest trip and /now drops trips mid-journey.
CACHE_TTL=45m
# /readyz reports not ready if no feed has succeeded within this window.
READY_MAX_FEED_AGE=120s
# Empty is off. When set, net/http/pprof listens here; loopback only, which
# config enforces, because profiles expose stacks and heap contents.
PPROF_ADDR=
# /v1/admin/stats listens here, never on HTTP_ADDR. Empty is off. Compose
# overrides it to :8081 and publishes that on the host's loopback only.
ADMIN_ADDR=127.0.0.1:8081

# --- Database pool ------------------------------------------------------------

# Postgres plus a large pool will OOM a 1 GB VM. The writer needs one
# connection; the API gets the rest.
DB_MAX_CONNS=10

# --- Observability ------------------------------------------------------------

# debug logs every decoded update and fills the disk within a day.
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
# Affects log rendering only. Service-day maths uses servicetime.Loc regardless.
TZ=Australia/Sydney
