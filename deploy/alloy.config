// Grafana Alloy on the VM: scrapes /metrics over the Compose network, where
// the admin port is reachable, and pushes to Grafana Cloud. /metrics is never
// public. The three values come from the VM's .env (deploy/vm-bootstrap.md).

prometheus.scrape "transitlateagain" {
  job_name        = "transitlateagain"
  targets         = [{"__address__" = "transitlateagain:8081"}]
  // One sample per series per minute is the free tier's allowance.
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_REMOTE_WRITE_URL")

    basic_auth {
      username = sys.env("GRAFANA_USERNAME")
      password = sys.env("GRAFANA_TOKEN")
    }
  }
}
